# Optional. With neither key set, the "What it looked like here" toggle shows an OpenStreetMap area snapshot.
NEXT_PUBLIC_MAPILLARY_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Optional. Off by default; the AI caption hook only ever sees curated cover photos.
NEXT_PUBLIC_AI_ASSISTANT_ENABLED=false

# Optional basemap override (default: OpenStreetMap standard tiles)
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=© OpenStreetMap contributors
# NEXT_PUBLIC_TILE_MAX_ZOOM=19
